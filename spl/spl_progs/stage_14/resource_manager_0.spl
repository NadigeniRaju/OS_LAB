alias functionNum R1;
alias currentPID R2;
if( functionNum == 8 ) then

    while(([TERMINAL_STATUS_TABLE]) == 1) do
        [PROCESS_TABLE + currentPID*16 + 4] = WAIT_TERMINAL;
        multipush(R1, R2);
        call SCHEDULER;
        multipop(R1, R2);
    endwhile;

    [TERMINAL_STATUS_TABLE] = 1;
    [TERMINAL_STATUS_TABLE + 1] = currentPID;

    return;
endif;

if( functionNum == 9 ) then

    alias statusPID R3;
    statusPID = [TERMINAL_STATUS_TABLE + 1];

    if( statusPID != currentPID) then
      R0 = -1;
      return;
    endif;

    [TERMINAL_STATUS_TABLE] = 0;

    alias count R4;
    alias process_table_entry R5;

    count = 0;
    process_table_entry = PROCESS_TABLE;

    while(count < 16) do
    
        if( [process_table_entry + 4] == WAIT_TERMINAL) then
           [process_table_entry + 4] = READY;
        endif;
        process_table_entry = process_table_entry + 16;
        count = count + 1;
    endwhile;

    R0 = 0;

    return;
endif;

   

