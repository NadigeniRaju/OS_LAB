alias functionNum R1;
alias currentPID R2;

if( functionNum == TERMINAL_WRITE) then
 multipush(R1, R2);
 R1 = ACQUIRE_TERMINAL;
 R2 = currentPID;
 call RESOURCE_MANAGER;
 multipop(R1, R2);
 alias word R3;

 print word;

 multipush(R1, R2, R3);
 R1 = RELEASE_TERMINAL;
 R2 = currentPID;
 call RESOURCE_MANAGER;
 multipop(R1, R2, R3);
 return;
endif;

if( functionNum == TERMINAL_READ) then
 multipush(R1, R2);
 R1 = ACQUIRE_TERMINAL;
 R2 = currentPID;
 call RESOURCE_MANAGER;
 multipop(R1, R2);

 read;

 [PROCESS_TABLE + currentPID*16 + 4] = WAIT_TERMINAL;
 multipush(R1, R2);
 call SCHEDULER;
 multipop(R1, R2);
 alias logicalLocation R3;
 alias physicalLocation R4;
 
 physicalLocation = [PTBR + (logicalLocation/512)*2]*512 + (logicalLocation%512);
 [physicalLocation] = [PROCESS_TABLE + currentPID*16 + 8];
 return;
endif;

return;



